{"uid": "yescare-capacity", "title": "YesCare \u2014 Capacity Planning", "tags": ["yescare", "p3", "capacity", "scaling"], "timezone": "browser", "refresh": "5m", "time": {"from": "now-7d", "to": "now"}, "schemaVersion": 38, "version": 1, "templating": {"list": [{"hide": 0, "includeAll": false, "label": "Data Source", "multi": false, "name": "datasource", "query": "prometheus", "refresh": 1, "type": "datasource"}]}, "panels": [{"id": 1, "title": "Node CPU Usage Trend", "type": "timeseries", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"refId": "A", "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "{{instance}} CPU %"}], "fieldConfig": {"defaults": {"unit": "percent", "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}}}, {"id": 2, "title": "Node Memory Usage Trend", "type": "timeseries", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"refId": "A", "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes * 100", "legendFormat": "{{instance}} Memory %"}], "fieldConfig": {"defaults": {"unit": "percent", "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}}}, {"id": 3, "title": "Loki PVC Usage", "type": "stat", "gridPos": {"x": 0, "y": 8, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"refId": "A", "expr": "kubelet_volume_stats_used_bytes{persistentvolumeclaim=\"loki-data\"} / kubelet_volume_stats_capacity_bytes{persistentvolumeclaim=\"loki-data\"} * 100", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"}, "fieldConfig": {"defaults": {"unit": "percent", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]}}, "overrides": []}}, {"id": 4, "title": "Tempo PVC Usage", "type": "stat", "gridPos": {"x": 6, "y": 8, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"refId": "A", "expr": "kubelet_volume_stats_used_bytes{persistentvolumeclaim=\"tempo-data\"} / kubelet_volume_stats_capacity_bytes{persistentvolumeclaim=\"tempo-data\"} * 100", "instant": true}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"}, "fieldConfig": {"defaults": {"unit": "percent", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]}}, "overrides": []}}, {"id": 5, "title": "JVM Heap Trend by Service (7d)", "type": "timeseries", "gridPos": {"x": 0, "y": 12, "w": 24, "h": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"refId": "A", "expr": "sum(jvm_memory_used_bytes{namespace=\"prod\",area=\"heap\"}) by (app) / sum(jvm_memory_max_bytes{namespace=\"prod\",area=\"heap\"}) by (app) * 100", "legendFormat": "{{app}} heap %"}], "fieldConfig": {"defaults": {"unit": "percent", "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}}}, {"id": 6, "title": "Request Rate Growth (7d trend)", "type": "timeseries", "gridPos": {"x": 0, "y": 20, "w": 24, "h": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{namespace=\"prod\"}[1h])) by (app)", "legendFormat": "{{app}}"}], "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}}}]}
