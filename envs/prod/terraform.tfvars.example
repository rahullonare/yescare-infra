# Copy to terraform.tfvars (gitignored) and fill in values.

region       = "blr1"
env          = "prod"
vpc_ip_range = "10.22.0.0/16"

k8s_version = "1.31.2-do.0"

k8s_node_size  = "s-2vcpu-4gb"
k8s_node_count = 2

db_username = "yescare_app"
db_size     = "db-s-2vcpu-4gb"
db_name = "yescareprod"

enable_spaces          = true
spaces_bucket_suffix   = "your-org-unique"

# Spaces API keys (not the same as do_token)
# spaces_access_id  = "..."
# spaces_secret_key = "..."

# export TF_VAR_do_token='dop_v1_...'
